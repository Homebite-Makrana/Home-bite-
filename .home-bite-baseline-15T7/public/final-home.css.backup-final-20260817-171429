  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  align-items:stretch!important;
  gap:4px!important;
  padding:5px!important;
  border:2px solid #f4c542!important;
  border-radius:25px!important;
  background:linear-gradient(135deg,#3d0000,#650000,#3d0000)!important;
  box-shadow:0 10px 30px #00000055!important;
}

.hb-final-nav button{
  min-width:0!important;
  min-height:55px!important;
  border:0!important;
  border-radius:18px!important;
  background:transparent!important;
  color:#f4c542!important;
  display:flex!important;
  flex-direction:column!important;
  align-items:center!important;
  justify-content:center!important;
  gap:1px!important;
  font-weight:900!important;
}

.hb-final-nav button span{
  color:#f4c542!important;
  font-size:21px!important;
  line-height:20px!important;
}

.hb-final-nav button b{
  color:#f4c542!important;
  font-size:11px!important;
}

.hb-final-nav button.active,
.hb-final-nav button.selected{
  background:#f4c542!important;
  color:#3d0000!important;
}

.hb-final-nav button.active span,
.hb-final-nav button.active b,
.hb-final-nav button.selected span,
.hb-final-nav button.selected b{
  color:#3d0000!important;
}

/* Exact app icon in header */
.top .brand .logo.hb-app-logo{
  width:45px!important;
  height:45px!important;
  min-width:45px!important;
  min-height:45px!important;
  max-width:45px!important;
  max-height:45px!important;
  padding:0!important;
  overflow:hidden!important;
  border-radius:11px!important;
  background:#650000!important;
}

.top .brand .logo.hb-app-logo img{
  display:block!important;
  width:45px!important;
  height:45px!important;
  object-fit:cover!important;
  border-radius:11px!important;
}

